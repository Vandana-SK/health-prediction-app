# Copy this file to ".env" and fill in real values for your environment.
# NEVER commit the real .env file (it is git-ignored).

# Flask session signing key
SECRET_KEY=change-me-to-a-random-string

# Optional: override the database location
# DATABASE_URL=sqlite:///instance/patients.db

# Optional: external Health/AI API endpoint. If set, it is tried before the
# local ML model. Keep any API key in this file only — never in source.
# HEALTH_API_URL=
